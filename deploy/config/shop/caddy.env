# Kinesis shop host (Linux layout): Caddy settings. No secrets.
# Install as /etc/kinesis/caddy.env, owner root:kinesis-proxy, mode 0640.
#
# Ports and origins are deliberately the ones already in use, so browser
# terminals paired against https://192.168.254.199:9443 stay paired after
# the move (cookies and the stored terminal credential do not change).
# They must match kinesis.env and the server certificate exactly; check with
#   deploy/migration/preflight.py --kinesis-env ... --caddy-env ...
KINESIS_DATA_DIR=/var/lib/kinesis
KINESIS_POS_WEB_ROOT=/opt/kinesis/web/pos
KINESIS_ADMIN_WEB_ROOT=/opt/kinesis/web/admin
KINESIS_BACKEND=127.0.0.1:8000
KINESIS_POS_SITES=https://192.168.254.199:9443, https://kinesis.local:9443
KINESIS_ADMIN_SITES=https://192.168.254.199:9444
KINESIS_ONBOARDING_SITE=http://192.168.254.199:9080
KINESIS_DEFAULT_SNI=kinesis.local
KINESIS_HTTP_PORT=9081
KINESIS_HTTPS_PORT=9443
