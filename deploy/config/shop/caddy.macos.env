# Kinesis shop host, macOS layout (launchd templates in deploy/services/launchd).
# Install as /Library/Application Support/Kinesis/config/caddy.env,
# owner root:_kinesisproxy, mode 0640. No secrets. Values with spaces are
# fine unquoted (the Caddyfile quotes every path placeholder).
#
# Ports and origins are the ones already in use, so browser terminals
# paired against https://192.168.254.199:9443 stay paired after the move.
KINESIS_DATA_DIR=/Library/Application Support/Kinesis
KINESIS_POS_WEB_ROOT=/Library/Application Support/Kinesis/web/pos
KINESIS_ADMIN_WEB_ROOT=/Library/Application Support/Kinesis/web/admin
KINESIS_BACKEND=127.0.0.1:8000
# kinesis.local is the canonical address for terminals and the admin
# console: it works through every LAN interface (Wi-Fi, Ethernet or both,
# advertised by kinesis-mdns) and the server certificate covers it. The
# 192.168.254.199 entries are a migration fallback for terminals paired
# before the switch; they work only while this computer holds that address.
# The onboarding page answers on every address of this computer (":9080"):
# it is plain HTTP and serves public CA material only.
KINESIS_POS_SITES=https://kinesis.local:9443, https://192.168.254.199:9443
KINESIS_ADMIN_SITES=https://kinesis.local:9444, https://192.168.254.199:9444
KINESIS_ONBOARDING_SITE=http://:9080
KINESIS_DEFAULT_SNI=kinesis.local
KINESIS_HTTP_PORT=9081
KINESIS_HTTPS_PORT=9443
# Caddy admin API on a Unix socket inside the _kinesisproxy-only (0700)
# caddy folder. Never a TCP port: any local account could use that to make
# Caddy serve the TLS keys.
KINESIS_CADDY_ADMIN=unix//Library/Application Support/Kinesis/caddy/admin.sock|0600
