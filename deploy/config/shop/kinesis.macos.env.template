# Kinesis shop host, macOS layout. Install as
# /Library/Application Support/Kinesis/config/kinesis.env, owner
# root:_kinesis, mode 0640. CONTAINS SECRETS once filled
# in. Never commit the filled-in file.
#
# Replace every __PLACEHOLDER__ (preflight.py refuses to pass while any
# remains):
#   KINESIS_ADMIN_AUTH_SECRET_KEY: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   DATABASE_PASSWORD: the password set for the kinesis_app role on THIS host
#     (a new value; never reuse the development machine's password).

KINESIS_ENVIRONMENT=production

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=kinesis
DATABASE_USER=kinesis_app
DATABASE_PASSWORD=__DATABASE_PASSWORD__

KINESIS_DATA_DIR=/Library/Application Support/Kinesis

# pg_dump/pg_restore for admin backups (EDB installer location).
KINESIS_PG_BIN_DIR=/Library/PostgreSQL/18/bin

KINESIS_ADMIN_AUTH_SECRET_KEY=__ADMIN_AUTH_SECRET_KEY__

# Must equal KINESIS_POS_SITES / KINESIS_ADMIN_SITES in caddy.env.
# kinesis.local is canonical; the 192.168.254.199 origins are a migration
# fallback and are retired in a later, separate change.
KINESIS_POS_ALLOWED_ORIGINS=https://kinesis.local:9443,https://192.168.254.199:9443
KINESIS_ADMIN_ALLOWED_ORIGINS=https://kinesis.local:9444,https://192.168.254.199:9444

KINESIS_POS_COOKIE_SECURE=true
KINESIS_ADMIN_COOKIE_SECURE=true
KINESIS_ADMIN_COOKIE_NAME=__Host-kinesis_admin_session
KINESIS_ADMIN_COOKIE_SAMESITE=strict
