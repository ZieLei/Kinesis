# Caddy settings for one Kinesis host. Copy to <DATA_DIR>/config/caddy.env
# and adjust. Loaded with: caddy run ... --envfile <DATA_DIR>/config/caddy.env
#
# Use forward slashes in paths on Windows too (C:/ProgramData/Kinesis).

# Data directory holding pki/ (kinesis-pki output) and onboarding/.
KINESIS_DATA_DIR=/var/lib/kinesis

# Built web applications (static files only; no Node.js on the host).
KINESIS_POS_WEB_ROOT=/opt/kinesis/web/pos
KINESIS_ADMIN_WEB_ROOT=/opt/kinesis/web/admin

# Backend (uvicorn) — loopback only.
KINESIS_BACKEND=127.0.0.1:8000

# Every name and address in the server certificate (kinesis-pki status).
KINESIS_POS_SITES=https://kinesis.local, https://shop-pc.local, https://192.168.1.10
KINESIS_ADMIN_SITES=https://kinesis.local:8443, https://shop-pc.local:8443, https://192.168.1.10:8443

# Plain-HTTP onboarding page, on the IP address only.
KINESIS_ONBOARDING_SITE=http://192.168.1.10:8080

# Certificate used when a device connects by IP (no SNI).
KINESIS_DEFAULT_SNI=kinesis.local

# Caddy admin API (used by `caddy reload`). On Linux and macOS use a Unix
# socket that only the proxy account can reach; a TCP port would let any
# local account reconfigure Caddy. Omit on Windows (localhost:2019).
#   Linux:  unix//run/kinesis-caddy/admin.sock|0600
#   macOS:  unix//Library/Application Support/Kinesis/caddy/admin.sock|0600
KINESIS_CADDY_ADMIN=unix//run/kinesis-caddy/admin.sock|0600
