# Kinesis backend configuration for one shop host.
#
# Copy to <DATA_DIR>/config/kinesis.env, restrict it to the service account
# (it contains secrets), and point the backend at it with the environment
# variable KINESIS_ENV_FILE (set by the service definition).
#
#   Linux    /etc/kinesis/kinesis.env                       (root:kinesis 0640)
#   macOS    /Library/Application Support/Kinesis/config/kinesis.env
#   Windows  C:\ProgramData\Kinesis\config\kinesis.env      (ACL: Administrators + service account)
#
# Never commit the real file. Never copy these values into EXPO_PUBLIC_*
# variables: those are compiled into the client apps.

KINESIS_ENVIRONMENT=production

# --- Database (PostgreSQL listening on localhost only) ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=kinesis
DATABASE_USER=kinesis
DATABASE_PASSWORD=change-me-generate-a-long-random-value

# --- Data locations (absolute; forward slashes work on Windows) ---
KINESIS_DATA_DIR=/var/lib/kinesis
# Optional overrides; relative values are resolved against KINESIS_DATA_DIR.
# KINESIS_IMAGE_DIRECTORY=uploads/products
# KINESIS_GCASH_QR_DIRECTORY=uploads/gcash
# KINESIS_DATABASE_BACKUP_DIRECTORY=backups

# PostgreSQL client tools (pg_dump/pg_restore) when not on PATH:
#   Windows  C:/Program Files/PostgreSQL/17/bin
#   macOS    /Library/PostgreSQL/17/bin  or  /Applications/Postgres.app/Contents/Versions/latest/bin
# KINESIS_PG_BIN_DIR=

# --- Secrets ---
# At least 32 random characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
KINESIS_ADMIN_AUTH_SECRET_KEY=

# --- Browser origins (must match the Caddy site addresses exactly) ---
KINESIS_POS_ALLOWED_ORIGINS=https://kinesis.local,https://shop-pc.local,https://192.168.1.10
KINESIS_ADMIN_ALLOWED_ORIGINS=https://kinesis.local:8443,https://shop-pc.local:8443,https://192.168.1.10:8443

# --- Cookies (production requires Secure; __Host- is applied automatically for POS) ---
KINESIS_POS_COOKIE_SECURE=true
KINESIS_ADMIN_COOKIE_SECURE=true
KINESIS_ADMIN_COOKIE_NAME=__Host-kinesis_admin_session
KINESIS_ADMIN_COOKIE_SAMESITE=strict

# --- Terminal credentials ---
# KINESIS_TERMINAL_TOKEN_ROTATION_DAYS=7
# KINESIS_TERMINAL_TOKEN_GRACE_SECONDS=120
# KINESIS_TERMINAL_CREDENTIAL_IDLE_DAYS=30
# KINESIS_TERMINAL_HEARTBEAT_TIMEOUT_SECONDS=90
