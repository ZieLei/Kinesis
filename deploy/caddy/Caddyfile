# Kinesis reverse proxy (Caddy v2) — Linux, macOS and Windows.
#
# Terminates HTTPS/WSS with certificates from the Kinesis local CA
# (deploy/pki), serves the POS and admin web builds, and forwards API calls
# to the backend, which listens on 127.0.0.1 only.
#
# All host-specific values come from environment variables, loaded with:
#
#   caddy run --config Caddyfile --adapter caddyfile --envfile <DATA_DIR>/config/caddy.env
#
# See deploy/config/caddy.env.example. Nothing here contacts the internet.
{
	# Certificates are issued by kinesis-pki. Never request public
	# certificates: the shop network is offline. HTTP->HTTPS redirects stay on.
	auto_https disable_certs

	# Devices reaching the server by IP address send no SNI.
	default_sni {$KINESIS_DEFAULT_SNI}

	# Port 80 only redirects to HTTPS. Override for testing as non-root.
	http_port {$KINESIS_HTTP_PORT:80}
	https_port {$KINESIS_HTTPS_PORT:443}

	# Admin API (used by `caddy reload`). Linux and macOS hosts set
	# KINESIS_CADDY_ADMIN to a Unix socket in a directory only the proxy
	# account can enter, e.g. "unix//run/kinesis-caddy/admin.sock|0600".
	# A TCP admin port would let ANY local account, including the backend's,
	# load a config that serves the TLS key directory. The localhost:2019
	# default remains for Windows, where both services run as LocalSystem.
	# Quoted: the macOS socket path contains a space.
	admin "{$KINESIS_CADDY_ADMIN:localhost:2019}"
}

# --------------------------------------------------
# Shared snippets
# --------------------------------------------------

(kinesis_tls) {
	# Quoted: data paths contain spaces on macOS (/Library/Application Support)
	# and Windows (C:/Program Files); placeholders are expanded before parsing.
	tls "{$KINESIS_DATA_DIR}/pki/server.crt" "{$KINESIS_DATA_DIR}/pki/server.key" {
		protocols tls1.2 tls1.3
	}
}

(security_headers) {
	header {
		# No includeSubDomains/preload: .local names cannot be preloaded.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}
}

(api_proxy) {
	header Cache-Control "no-store"

	# Caddy replaces any client-supplied X-Forwarded-For with the real
	# client address; uvicorn trusts it only from 127.0.0.1
	# (--proxy-headers --forwarded-allow-ips 127.0.0.1).
	reverse_proxy {$KINESIS_BACKEND}
}

# --------------------------------------------------
# POS web app (Expo web build) and POS API — port 443
# --------------------------------------------------

{$KINESIS_POS_SITES} {
	import kinesis_tls
	import security_headers

	header {
		# 'unsafe-inline' styles: React Native Web injects style elements.
		# The single inline script is Expo Router's constant hydration flag,
		# allowed by hash (re-check with deploy/tools/check_web_build.py
		# after upgrading Expo).
		# GCash reference OCR (tesseract.js, served from /tesseract on this
		# origin) runs in a Web Worker and compiles WebAssembly:
		# worker-src 'self' (no blob: workers) and 'wasm-unsafe-eval', which
		# permits WebAssembly compilation only, never JavaScript eval().
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-67fhrP0+BkBqmgGGXTtgiVO/9EQs3QruYNU/7fnRkI8='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"
	}

	# Only the API areas the POS app uses are reachable from this origin.
	# Administrator, authentication and console endpoints are served on the
	# admin origin only: browser cookies are shared between ports of the
	# same host, so a script on this origin must not reach them.
	@pos_api path /api/terminals/* /api/cashier-auth/* /api/products /api/products/* /api/services /api/services/* /api/inventory/* /api/sales /api/sales/* /api/reports/*

	handle @pos_api {
		import api_proxy
	}

	handle /api/* {
		respond 404
	}

	handle {
		root * "{$KINESIS_POS_WEB_ROOT}"
		try_files {path} {path}.html {path}/index.html /index.html
		file_server
	}
}

# --------------------------------------------------
# Admin console (Vite build) and full API — port 8443
# --------------------------------------------------

{$KINESIS_ADMIN_SITES} {
	import kinesis_tls
	import security_headers

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"
	}

	handle /api/* {
		import api_proxy
	}

	handle {
		root * "{$KINESIS_ADMIN_WEB_ROOT}"
		try_files {path} /index.html
		file_server
	}
}

# --------------------------------------------------
# Device onboarding — plain HTTP, CA certificate ONLY
# --------------------------------------------------
#
# A device cannot use HTTPS before it trusts the Kinesis CA, so this page
# is served over HTTP on the host's IP address (HSTS does not apply to IP
# addresses). It exposes nothing but public CA material; users confirm the
# root fingerprint against the host screen before trusting it.

{$KINESIS_ONBOARDING_SITE} {
	header {
		X-Content-Type-Options "nosniff"
		Cache-Control "no-store"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'"
		-Server
	}

	@crt path /kinesis-root.crt /kinesis-root.cer
	header @crt Content-Type "application/x-x509-ca-cert"

	@profile path /kinesis-root.mobileconfig
	header @profile Content-Type "application/x-apple-aspen-config"

	@public path / /index.html /kinesis-root.crt /kinesis-root.cer /kinesis-root.mobileconfig /fingerprint.txt

	handle @public {
		root * "{$KINESIS_DATA_DIR}/onboarding"
		file_server
	}

	handle {
		respond 404
	}
}
