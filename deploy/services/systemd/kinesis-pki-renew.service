[Unit]
Description=Renew the Kinesis server certificate when due

[Service]
Type=oneshot
User=kinesis-proxy
Group=kinesis-proxy
# reload_command / reload_env_file are stored in pki.json by `init`/`renew`.
ExecStart=/opt/kinesis/venv/bin/python /opt/kinesis/deploy/pki/kinesis_pki.py --pki-dir /var/lib/kinesis/pki renew
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kinesis/pki
