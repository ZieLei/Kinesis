# Kinesis TLS reverse proxy. Runs as "kinesis-proxy", the only account that
# can read the TLS keys in /var/lib/kinesis/pki (the backend account cannot).
[Unit]
Description=Kinesis HTTPS reverse proxy (Caddy)
After=network-online.target kinesis-backend.service
Wants=network-online.target

[Service]
Type=notify
User=kinesis-proxy
Group=kinesis-proxy
# Renew first if the certificate is due (no-op otherwise).
ExecStartPre=/opt/kinesis/venv/bin/python /opt/kinesis/deploy/pki/kinesis_pki.py --pki-dir /var/lib/kinesis/pki renew --no-reload
ExecStart=/usr/bin/caddy run --environ --config /opt/kinesis/deploy/caddy/Caddyfile --adapter caddyfile --envfile /etc/kinesis/caddy.env
ExecReload=/usr/bin/caddy reload --config /opt/kinesis/deploy/caddy/Caddyfile --adapter caddyfile --force
EnvironmentFile=/etc/kinesis/caddy.env
TimeoutStopSec=10
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kinesis/pki /var/lib/caddy
Environment=XDG_DATA_HOME=/var/lib/caddy XDG_CONFIG_HOME=/var/lib/caddy

[Install]
WantedBy=multi-user.target
