# Kinesis TLS reverse proxy (Caddy), system-wide install. Runs as
# "kinesis-proxy", the only account that can read the TLS keys in
# /var/lib/kinesis/pki (the backend account cannot).
#
# Caddy keeps its own state (autosave.json, locks) in /var/lib/kinesis/caddy.
# Do not point it at /var/lib/caddy: the distribution's "caddy" package owns
# that directory (user caddy), so kinesis-proxy cannot write it. The
# distribution's own caddy.service must stay disabled.
#
# The admin API listens on /run/kinesis-caddy/admin.sock (KINESIS_CADDY_ADMIN
# in caddy.env): the directory is 0700 kinesis-proxy, so no other account can
# reconfigure Caddy.
[Unit]
Description=Kinesis HTTPS reverse proxy (Caddy)
After=network-online.target kinesis-backend.service
Wants=network-online.target
PartOf=kinesis.target

[Service]
Type=notify
User=kinesis-proxy
Group=kinesis-proxy
RuntimeDirectory=kinesis-caddy
RuntimeDirectoryMode=0700
# Renew first if the certificate is due (no-op otherwise). The leading "-"
# lets Caddy start with the current, still valid certificate if the renewal
# check itself fails; the failure is logged in the journal.
ExecStartPre=-/opt/kinesis/pki-venv/bin/python /opt/kinesis/deploy/pki/kinesis_pki.py --pki-dir /var/lib/kinesis/pki renew --no-reload
ExecStart=/usr/bin/caddy run --config /opt/kinesis/deploy/caddy/Caddyfile --adapter caddyfile --envfile /etc/kinesis/caddy.env
ExecReload=/usr/bin/caddy reload --config /opt/kinesis/deploy/caddy/Caddyfile --adapter caddyfile --force
EnvironmentFile=/etc/kinesis/caddy.env
Environment=PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
TimeoutStopSec=10
Restart=on-failure
RestartSec=3
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kinesis/pki /var/lib/kinesis/caddy
InaccessiblePaths=-/var/lib/kinesis/backups -/var/lib/kinesis/uploads -/etc/kinesis/kinesis.env
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
Environment=XDG_DATA_HOME=/var/lib/kinesis/caddy XDG_CONFIG_HOME=/var/lib/kinesis/caddy

[Install]
WantedBy=kinesis.target
