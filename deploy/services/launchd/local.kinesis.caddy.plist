<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Kinesis HTTPS reverse proxy (macOS). Runs as _kinesisproxy, the only
     account that can read Kinesis TLS keys. Binding ports 80/443 as a
     non-root daemon is permitted on macOS 10.14 and later. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.kinesis.caddy</string>
  <key>UserName</key><string>_kinesisproxy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Application Support/Kinesis/bin/caddy</string>
    <string>run</string>
    <string>--config</string><string>/Library/Application Support/Kinesis/app/deploy/caddy/Caddyfile</string>
    <string>--adapter</string><string>caddyfile</string>
    <string>--envfile</string><string>/Library/Application Support/Kinesis/config/caddy.env</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>XDG_DATA_HOME</key><string>/Library/Application Support/Kinesis/caddy</string>
    <key>XDG_CONFIG_HOME</key><string>/Library/Application Support/Kinesis/caddy</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardErrorPath</key><string>/Library/Application Support/Kinesis/logs/caddy.log</string>
</dict>
</plist>
