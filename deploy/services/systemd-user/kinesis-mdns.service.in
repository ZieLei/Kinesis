# Optional kinesis.local responder (user scope), installed with --mdns.
# Follows the LAN interfaces by itself (Wi-Fi, Ethernet, both, neither):
# it advertises every address inside the allowed subnets (--subnet) and
# waits when there is none, so a missing interface is not a failure.
[Unit]
Description=Kinesis mDNS responder (@MDNS_HOSTNAME@)
PartOf=kinesis.target

[Service]
Type=exec
Environment=PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=@CODE@/mdns-venv/bin/python @CODE@/deploy/mdns/kinesis_mdns.py --hostname @MDNS_HOSTNAME@ --port @MDNS_PORT@ @MDNS_SUBNET_ARGS@
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=@CODE@/deploy/mdns @CODE@/mdns-venv @PYTHON_HOME_BIND@
TemporaryFileSystem=%t:ro
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes

[Install]
WantedBy=kinesis.target
