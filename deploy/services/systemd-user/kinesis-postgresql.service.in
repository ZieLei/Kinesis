# Kinesis PostgreSQL @PG_MAJOR@ cluster owned by this account (user scope).
# Generated by install-kinesis.sh --scope user. Data: @DATA@/postgres.
# TCP 127.0.0.1:@PG_PORT@ only (scram-sha-256); the Unix socket in
# $XDG_RUNTIME_DIR/kinesis-postgresql (peer auth) is for kinesisctl only and
# is hidden from the other Kinesis services.
[Unit]
Description=Kinesis PostgreSQL @PG_MAJOR@ (user-owned cluster)
PartOf=kinesis.target

[Service]
Type=notify
RuntimeDirectory=kinesis-postgresql
RuntimeDirectoryMode=0700
# Refuses to start a data directory from another PostgreSQL major version
# (for example after a pacman upgrade to a new major), with instructions.
ExecStartPre=@PG_CHECK@
ExecStart=@PG_BIN@/postgres -D @DATA@/postgres -c listen_addresses=127.0.0.1 -c port=@PG_PORT@ -c unix_socket_directories=%t/kinesis-postgresql
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGINT
TimeoutSec=120
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=@DATA@/postgres
TemporaryFileSystem=%t:ro
BindPaths=%t/kinesis-postgresql %t/systemd/notify
LockPersonality=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=kinesis.target
