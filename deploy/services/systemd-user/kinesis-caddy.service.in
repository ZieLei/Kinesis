# Kinesis TLS reverse proxy (Caddy), user scope. Generated by
# install-kinesis.sh --scope user. The admin API is a Unix socket in
# $XDG_RUNTIME_DIR/kinesis-caddy (0700), never a TCP port.
[Unit]
Description=Kinesis HTTPS reverse proxy (Caddy)
After=kinesis-backend.service
PartOf=kinesis.target

[Service]
Type=notify
RuntimeDirectory=kinesis-caddy
RuntimeDirectoryMode=0700
# Renew first if the certificate is due (no-op otherwise); "-" lets Caddy
# start with the current, still valid certificate if the check fails.
ExecStartPre=-@CODE@/pki-venv/bin/python @CODE@/deploy/pki/kinesis_pki.py --pki-dir @DATA@/pki renew --no-reload
ExecStart=@CADDY@ run --config @CODE@/deploy/caddy/Caddyfile --adapter caddyfile --envfile @CONFIG@/caddy.env
ExecReload=@CADDY@ reload --config @CODE@/deploy/caddy/Caddyfile --adapter caddyfile --force
EnvironmentFile=@CONFIG@/caddy.env
Environment=PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
Environment=XDG_DATA_HOME=@DATA@/caddy XDG_CONFIG_HOME=@DATA@/caddy
TimeoutStopSec=10
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=@CODE@/deploy @CODE@/web @CODE@/pki-venv @PYTHON_HOME_BIND@ @CONFIG@/caddy.env @DATA@/onboarding
# The certificate directory (may be a link to an existing PKI folder) is
# mounted at <DATA>/pki; renewal writes there.
BindPaths=@PKI_REAL@:@DATA@/pki @DATA@/caddy
TemporaryFileSystem=%t:ro
BindPaths=%t/kinesis-caddy %t/systemd/notify
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=kinesis.target
