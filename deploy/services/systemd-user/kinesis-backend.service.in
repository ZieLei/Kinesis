# Kinesis backend (FastAPI/uvicorn), user scope. Generated by
# install-kinesis.sh --scope user.
[Unit]
Description=Kinesis POS backend
@BACKEND_PG_DEPS@
After=kinesis-postgresql.service
PartOf=kinesis.target

[Service]
Type=exec
Environment=KINESIS_ENV_FILE=@CONFIG@/kinesis.env
Environment=PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=@CODE@/backend
# One worker: settings WebSockets, backup locking and console sessions are
# per-process. Loopback only: devices must come through the TLS proxy.
ExecStart=@CODE@/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header --timeout-graceful-shutdown 20
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=3
UMask=0077

# Sandbox: the home directory is replaced by an empty tmpfs that shows only
# the backend's code (read-only), its env file and its data folders. It
# cannot see the TLS keys, the PostgreSQL superuser socket, the Caddy admin
# socket or the user's systemd/D-Bus sockets.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=@CODE@/backend @CODE@/venv @PYTHON_HOME_BIND@ @CONFIG@/kinesis.env
BindPaths=@DATA@/uploads @DATA@/backups
TemporaryFileSystem=%t:ro
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=kinesis.target
